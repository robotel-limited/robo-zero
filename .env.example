# Copy to .env and fill in the keys for whichever models you'll use.
# robo-zero only reads the key for the model actually selected in a chat
# or project (see llm.py's MODEL catalog) — you don't need all of these.

DEEPSEEK_API_KEY=
QWEN_APIKEY=
NVIDIA_API_KEY=

# Optional: only needed if you run the robo_rag_tool.py tool against your
# own robo-rag instance (https://github.com/robotel-limited/robo-rag).
# ROBORAG_BASE_URL=
# ROBORAG_TENANT_ID=
# ROBORAG_COLLECTION_ID=
# ROBORAG_ADMIN_EMAIL=
# ROBORAG_ADMIN_PASSWORD=
